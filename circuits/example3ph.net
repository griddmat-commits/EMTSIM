# Three-phase example for EMTSim, generated by circuits/make_example3ph.py.
# Open it in the circuit editor (gui.bat) to see the drawing.
#
#             line                       breaker (independent poles)
#     G ---- R3 -- L3 ---- bus 3 -------- SW3 ---- bus 4
#                           |  |  |                 |   |
#                          R3 C3  F3 (a-g)         R3  L3 (motor)
#
# * G: 230 V rms (325 V peak phase-to-ground), 50 Hz, positive sequence,
#   0.1 ohm internal resistance (Norton). Phases b and c lag a by 120 and 240 deg.
# * Line: 0.5 ohm + 5 mH per phase. Load at bus 3: 20 ohm || 50 uF per phase.
# * Motor feeder behind the breaker: 30 ohm || 0.2 H per phase.
#
# Events
# ------
#     40 ms  single-line-to-ground fault, phase a at bus 3 (F3, type a-g)
#     70 ms  fault cleared
#     80.0 ms  breaker pole a opens
#     83.3 ms  breaker pole b opens   (poles part at successive current zeros,
#     86.7 ms  breaker pole c opens    about 1/6 cycle apart)
#
# Every part is three-phase in the drawing; the netlist has three single-phase
# elements per part (names ending in .a, .b, .c) and drawing node k is netlist
# node 3k-2 (a), 3k-1 (b), 3k (c). There is no mutual coupling between phases.
#
# EMTSim netlist: three-phase example (drawn with the EMTSim circuit editor)
#
# Format: R/L/C from to value | V from to peak angle freq [R] | SW from to closed|open times... | F from to t_apply [t_clear]
# 12 nodes (4 three-phase nodes), 25 elements
# Three-phase drawing: node k of the drawing is netlist node 3k-2 (phase a), 3k-1 (b) and 3k (c)

V 0 1  325 0 50 0.1   # G.a
V 0 2  325 -120 50 0.1   # G.b
V 0 3  325 120 50 0.1   # G.c
R 1 4  0.5   # R_line.a
R 2 5  0.5   # R_line.b
R 3 6  0.5   # R_line.c
L 4 7  0.005   # L_line.a
L 5 8  0.005   # L_line.b
L 6 9  0.005   # L_line.c
R 7 0  20   # R_load.a
R 8 0  20   # R_load.b
R 9 0  20   # R_load.c
C 7 0  0.00005   # C_load.a
C 8 0  0.00005   # C_load.b
C 9 0  0.00005   # C_load.c
F 7 0  0.04 0.07   # F_SLG.a
SW 7 10  closed 0.08   # BRK.a
SW 8 11  closed 0.0833   # BRK.b
SW 9 12  closed 0.0867   # BRK.c
R 10 0  30   # R_motor.a
R 11 0  30   # R_motor.b
R 12 0  30   # R_motor.c
L 10 0  0.2   # L_motor.a
L 11 0  0.2   # L_motor.b
L 12 0  0.2   # L_motor.c

#@layout {"v":1,"components":[{"type":"V3","name":"G","x":2,"y":12,"rot":270,"params":{"mag":"325","angle":"0","freq":"50","r":"0.1"}},{"type":"GND","name":"GND","x":2,"y":12,"rot":0,"params":{}},{"type":"R3","name":"R_line","x":4,"y":8,"rot":0,"params":{"value":"0.5"}},{"type":"L3","name":"L_line","x":8,"y":8,"rot":0,"params":{"value":"0.005"}},{"type":"R3","name":"R_load","x":12,"y":8,"rot":90,"params":{"value":"20"}},{"type":"GND","name":"GND","x":12,"y":12,"rot":0,"params":{}},{"type":"C3","name":"C_load","x":16,"y":8,"rot":90,"params":{"value":"5e-05"}},{"type":"GND","name":"GND","x":16,"y":12,"rot":0,"params":{}},{"type":"F3","name":"F_SLG","x":20,"y":8,"rot":0,"params":{"kind":"a-g","mode":"together","t_apply":"0.04","t_clear":"0.07"}},{"type":"SW3","name":"BRK","x":23,"y":8,"rot":0,"params":{"mode":"independent","state_a":"closed","times_a":"0.08","state_b":"closed","times_b":"0.0833","state_c":"closed","times_c":"0.0867"}},{"type":"R3","name":"R_motor","x":27,"y":8,"rot":90,"params":{"value":"30"}},{"type":"GND","name":"GND","x":27,"y":12,"rot":0,"params":{}},{"type":"L3","name":"L_motor","x":30,"y":8,"rot":90,"params":{"value":"0.2"}},{"type":"GND","name":"GND","x":30,"y":12,"rot":0,"params":{}}],"wires":[{"x1":2,"y1":8,"x2":4,"y2":8},{"x1":12,"y1":8,"x2":23,"y2":8},{"x1":27,"y1":8,"x2":30,"y2":8}],"phases":3}
